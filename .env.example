# Ollama — set model IDs to whatever you have pulled (`ollama list`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_ORCHESTRATOR_MODEL=llama3.1
OLLAMA_WORKER_MODEL=llama3.1

# --- GEPA (all optimization settings live here) ---
# Prefer a stronger reflection model than the task model.
# IDs may be bare Ollama names or LiteLLM-prefixed (ollama/<name>).
GEPA_TASK_LM=ollama/llama3.1
GEPA_REFLECTION_LM=ollama/llama3.1
GEPA_MAX_METRIC_CALLS=20
GEPA_REFLECTION_MINIBATCH_SIZE=3
GEPA_CANDIDATE_SELECTION_STRATEGY=pareto
GEPA_SEED=0
GEPA_DISPLAY_PROGRESS=true
# If true, keep the seed prompt when GEPA best score does not beat seed
GEPA_PREFER_SEED_ON_TIE=true
GEPA_DATA_DIR=data/gepa
GEPA_RUNS_DIR=gepa_runs
GEPA_REPORT_DIR=artifacts/gepa

# Paths (relative to project root)
OUTPUT_DIR=output/spa
ARTIFACTS_DIR=artifacts

# Strands: skip interactive tool consent prompts
BYPASS_TOOL_CONSENT=true
